---
import HeroScroll from '../components/HeroScroll.astro';
import ServicesLights from '../components/sections/ServicesLights.astro';
import Story from '../components/sections/Story.astro';
import Expertise from '../components/sections/Expertise.astro';
import Projects from '../components/sections/Projects.astro';
import SiteFooter from '../components/sections/SiteFooter.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>shot</title>
    <style is:global>
      :root {
        --ink: #04070f;
        --ink-2: #070d1c;
        --ink-3: #0c1630;
        --text: #e9eefb;
        --muted: rgb(233 238 251 / .62);
        --line: rgb(255 255 255 / .1);
        --electric: #3d8bff;
        --volt: #ffc24b;
        --serif: 'Cormorant Garamond', 'Times New Roman', serif;
        --sans: 'Inter Variable', Inter, system-ui, sans-serif;
      }
      *, *::before, *::after { box-sizing: border-box; }
      body { margin: 0; background: var(--ink); color: var(--text); font-family: var(--sans); }
    </style>
  </head>
  <body>
    <main>
      <HeroScroll />
      <ServicesLights />
      <Story />
      <Expertise />
      <Projects />
      <SiteFooter />
    </main>
    <script is:inline>
      const y = Number(new URLSearchParams(location.search).get('y') || 0);
      const go = () => window.scrollTo(0, y * Math.max(0, document.documentElement.scrollHeight - window.innerHeight));
      window.addEventListener('load', () => {
        go();
        setTimeout(go, 200);
        setTimeout(() => { document.title = 'h' + document.documentElement.scrollHeight + '_y' + window.scrollY + '_vh' + window.innerHeight; }, 600);
      });
    </script>
    <script>
      import '../scripts/site-anim';
    </script>
  </body>
</html>
