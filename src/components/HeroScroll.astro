---
/**
 * HeroScroll — sequência de frames do vídeo de referência scrubbed pelo scroll.
 * Canvas + GSAP ScrollTrigger (padrão "Image Sequence Scrubbing" da skill).
 * Frames: public/hero/frames/frame_0001.jpg … frame_0163.jpg (12 fps, 13,6s)
 */
import '@fontsource/cormorant-garamond/300.css';
import '@fontsource/cormorant-garamond/300-italic.css';
import '@fontsource-variable/inter';

const base = import.meta.env.BASE_URL;
const site = 'https://quantumelectricalsolutions.com.au';

const content = {
  brand: 'Quantum',
  logo: `${base}logo-branco-quantum-2026-hor.png`,
  phone: { label: '0406 025 213', href: 'tel:61406025213' },
  nav: [
    { label: 'Electrical Services', href: `${site}/electrical-instalations/` },
    { label: 'Sports Lighting', href: `${site}/sports-lighting-quantum/` },
    { label: 'Maintenance', href: `${site}/maintenance/` },
    { label: 'About Us', href: `${site}/welcome-to-quantum-electrical-solutions/` },
  ],
  poster: `${base}hero/01-poster.jpg`,
  seq: { dir: `${base}hero/frames`, count: 163 },
  copy1: {
    eyebrow: 'Quantum Electrical & Technological Services',
    line1: 'Refined Luxury',
    line2: 'Absolute Precision',
    text: 'Seamless Integration from Blueprint to Handover.',
    primary: 'Call now for a quote',
    secondary: 'More details',
    // Valores reais do site (licenças e atendimento).
    stats: [
      { value: 24, suffix: '/7', label: 'Emergency call out' },
      { value: 478965, suffix: 'C', label: 'Contractor license' },
    ],
  },
  copy2: {
    eyebrow: 'Smart Automation & Architectural Lighting',
    line1: 'Unify projects',
    line2: 'without financial friction',
    text: 'Luxury home automation ecosystems and invisible integration of designer luminaires. Precision DALI-2 flicker-free lighting control, human-centric circadian automation, and switch clutter elimination.',
    specs: [
      { icon: 'area', value: 'DALI-2', label: 'lighting control' },
      { icon: 'length', value: 'Circadian', label: 'automation' },
      { icon: 'compass', value: 'Dynalite', label: 'home automation' },
    ],
  },
  copy3: {
    eyebrow: 'High Standard',
    before: 'Budget Certainty.',
    italic: 'Zero Timeline Surprises.',
    text: 'High-End Operational Rigor.',
    cards: [
      { title: 'Design and Constructional', img: `${base}hero/card-living.jpg`, href: `${site}/electrical-instalations/` },
      { title: 'Smart Automation & Architectural Lighting', img: `${base}hero/card-pavilion.jpg`, href: `${site}/maintenance/` },
      { title: 'Electronic Security & Sports Lighting Infrastructure', img: `${base}hero/card-night.jpg`, href: `${site}/sports-lighting-quantum/` },
    ],
  },
};
---

<script is:inline>document.documentElement.classList.add('js')</script>

<section class="hero" data-hero aria-label={content.brand}>
  <div class="stage" aria-hidden="true">
    <img class="poster" src={content.poster} alt="" width="1600" height="900" fetchpriority="high" decoding="async" />
    <canvas
      class="seq"
      data-seq
      data-frame-dir={content.seq.dir}
      data-frame-count={content.seq.count}
    ></canvas>
    <div class="shade"></div>
    <div class="loader" data-loader>
      <span data-loader-count>0%</span>
      <span class="loader__track"><i class="loader__fill" data-loader-fill></i></span>
    </div>
  </div>

  <header class="nav" data-nav>
    <a class="nav__brand" href={site} aria-label="Quantum Electrical & Technological Services">
      <img src={content.logo} alt="" width="4362" height="1158" decoding="async" />
    </a>
    <nav class="nav__links" aria-label="Primary">
      {content.nav.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <a class="nav__cta" href={content.phone.href}>{content.phone.label}</a>
  </header>

  <h1 class="title" aria-label="Quantum Electrical & Technological Services">
    <img class="title__logo" src={content.logo} alt="" data-title-logo width="4362" height="1158" decoding="async" />
  </h1>

  <!-- Bloco 1 -->
  <div class="copy copy--1" data-copy="1">
    <p class="eyebrow" data-reveal>{content.copy1.eyebrow}</p>
    <h2 class="headline" data-reveal>
      {content.copy1.line1}<br /><em>{content.copy1.line2}</em>
    </h2>
    <p class="lead" data-reveal>{content.copy1.text}</p>
    <div class="actions" data-reveal>
      <a class="btn btn--solid" href={content.phone.href}>{content.copy1.primary}</a>
      <a class="btn btn--ghost" href={`${site}/electrical-instalations/`}>{content.copy1.secondary}</a>
    </div>

    <ul class="stats" data-reveal>
      {content.copy1.stats.map((s) => (
        <li>
          <span class="stats__value"><span data-count={s.value} data-suffix={s.suffix}>{s.value}{s.suffix}</span></span>
          <span class="stats__label">{s.label}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Bloco 2 -->
  <div class="copy copy--2" data-copy="2">
    <p class="eyebrow" data-reveal>{content.copy2.eyebrow}</p>
    <h2 class="headline" data-reveal>
      {content.copy2.line1}<br /><em>{content.copy2.line2}</em>
    </h2>
    <p class="lead" data-reveal>{content.copy2.text}</p>
    <ul class="specs" data-reveal>
      {content.copy2.specs.map((s) => (
        <li>
          <span class="specs__icon" aria-hidden="true">
            {s.icon === 'length' && <svg viewBox="0 0 24 24"><path d="M4 12h16M4 8v8M20 8v8" /></svg>}
            {s.icon === 'area' && <svg viewBox="0 0 24 24"><rect x="5" y="5" width="14" height="14" rx="1" /><path d="M5 12h14M12 5v14" /></svg>}
            {s.icon === 'compass' && <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8" /><path d="m15 9-2 5-4 1 2-5z" /></svg>}
          </span>
          <span class="specs__value">{s.value}</span>
          <span class="specs__label">{s.label}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Bloco 3 -->
  <div class="copy copy--3" data-copy="3">
    <p class="eyebrow" data-reveal>{content.copy3.eyebrow}</p>
    <h2 class="headline headline--wide" data-reveal>
      {content.copy3.before} <em>{content.copy3.italic}</em>
    </h2>
    <p class="lead" data-reveal>{content.copy3.text}</p>
  </div>

  <ul class="cards" data-cards>
    {content.copy3.cards.map((c) => (
      <li class="card-wrap">
        <a class="card" href={c.href}>
          <img class="card__img" src={c.img} alt="" width="640" height="420" loading="lazy" decoding="async" />
          <span class="card__title">{c.title}</span>
          <span class="card__arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M7 17 17 7M9 7h8v8" /></svg>
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .hero {
    --serif: 'Cormorant Garamond', 'Times New Roman', serif;
    --sans: 'Inter Variable', Inter, system-ui, sans-serif;

    position: relative;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    color: #fff;
    font-family: var(--sans);
    background: #050912;
    isolation: isolate;
  }

  /* ---------- Stage ---------- */
  .stage { position: absolute; inset: 0; z-index: 0; }
  .poster,
  .seq {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
  }
  .seq {
    opacity: 0;
    transition: opacity .4s ease;
    will-change: opacity;
  }
  .seq.is-ready { opacity: 1; }
  .shade {
    position: absolute; inset: 0; pointer-events: none;
    background:
      linear-gradient(90deg, rgb(4 9 22 / .5) 0%, rgb(4 9 22 / .12) 45%, transparent 70%),
      linear-gradient(0deg, rgb(4 9 22 / .55) 0%, transparent 38%),
      linear-gradient(180deg, rgb(4 9 22 / .35) 0%, transparent 22%);
  }

  /* ---------- Loader ---------- */
  .loader {
    position: absolute; z-index: 6;
    left: 50%; bottom: 1.25rem;
    translate: -50% 0;
    display: none; align-items: center; gap: .6rem;
    padding: .45rem .85rem;
    border-radius: 999px;
    background: rgb(0 0 0 / .35);
    border: 1px solid rgb(255 255 255 / .18);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    font-size: .6rem; letter-spacing: .14em; text-transform: uppercase;
    pointer-events: none;
  }
  .loader__track { width: 5.5rem; height: 2px; border-radius: 2px; background: rgb(255 255 255 / .25); overflow: hidden; }
  .loader__fill { display: block; width: 100%; height: 100%; background: #fff; transform: scaleX(0); transform-origin: left; }

  /* ---------- Nav ---------- */
  .nav {
    position: absolute; z-index: 5; top: 0; left: 0; right: 0;
    display: flex; align-items: center; gap: 2rem;
    padding: clamp(1rem, 2.4vw, 1.75rem) clamp(1.25rem, 3vw, 2.5rem);
    font-size: .75rem;
  }
  .nav a { color: inherit; text-decoration: none; }
  .nav__brand { display: block; margin-right: auto; }
  .nav__brand img { display: block; height: clamp(1.4rem, 2.2vw, 1.9rem); width: auto; }
  .nav__links { display: flex; gap: 2rem; opacity: .85; }
  .nav__cta { border: 1px solid rgb(255 255 255 / .55); border-radius: 999px; padding: .5rem 1.1rem; }
  .nav a:focus-visible, .btn:focus-visible, .card:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }

  /* ---------- Logo QUANTUM ---------- */
  .title {
    position: absolute; z-index: 3; left: 0; right: 0; top: 46%;
    margin: 0; translate: 0 -50%;
    display: flex; justify-content: center;
    transform-origin: 50% 50%;
    pointer-events: none;
  }
  .title__logo {
    display: block;
    width: min(70vw, 56rem);
    height: auto;
    filter: drop-shadow(0 2px 40px rgb(0 0 0 / .35));
    will-change: transform, opacity;
  }

  /* ---------- Blocos de texto ---------- */
  .copy { position: absolute; z-index: 4; left: clamp(1.25rem, 3vw, 2.5rem); }
  .copy--1 { bottom: clamp(1.5rem, 5vh, 3.5rem); width: min(34rem, 80vw); }
  .copy--2 { top: 17vh; width: min(30rem, 80vw); }
  .copy--3 { top: 9vh; right: clamp(1.25rem, 3vw, 2.5rem); left: auto; text-align: right; }
  .copy--3 .lead { margin-left: auto; }

  .eyebrow { margin: 0 0 1rem; font-size: .625rem; letter-spacing: .2em; text-transform: uppercase; opacity: .75; }
  .headline { margin: 0; font: 300 clamp(2.4rem, 4.6vw, 4.4rem) / 1.02 var(--serif); letter-spacing: -.01em; }
  .headline--wide { font-size: clamp(2rem, 3.6vw, 3.4rem); }
  .headline em { font-style: italic; }
  .lead { margin: 1.1rem 0 0; max-width: 28rem; font-size: .8rem; line-height: 1.6; opacity: .8; }

  .actions { display: flex; gap: .75rem; margin-top: 1.6rem; }
  .btn { display: inline-flex; align-items: center; padding: .7rem 1.3rem; border-radius: 999px; font-size: .72rem; text-decoration: none; }
  .btn--solid { background: #fff; color: #0a1020; }
  .btn--ghost { color: #fff; border: 1px solid rgb(255 255 255 / .5); }

  .stats { list-style: none; margin: 0; padding: 0; }
  .stats li { display: grid; gap: .1rem; text-align: center; }
  .stats__value { font: 300 1.6rem / 1 var(--serif); }
  .stats__label { font-size: .5rem; letter-spacing: .12em; text-transform: uppercase; opacity: .7; }

  .specs { list-style: none; margin: 1.6rem 0 0; padding: 0; display: flex; gap: 1.6rem; }
  .specs li { display: grid; gap: .25rem; justify-items: start; }
  .specs__icon { width: 1.6rem; height: 1.6rem; display: grid; place-items: center; border: 1px solid rgb(255 255 255 / .5); border-radius: 50%; }
  .specs__icon svg { width: 62%; fill: none; stroke: #fff; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .specs__value { font: 300 1.25rem / 1 var(--serif); }
  .specs__label { font-size: .5rem; letter-spacing: .12em; text-transform: uppercase; opacity: .7; }

  /* ---------- Cards de vidro ---------- */
  .cards {
    position: absolute; z-index: 4; left: clamp(1.25rem, 3vw, 2.5rem); bottom: clamp(1.25rem, 4vh, 2.5rem);
    margin: 0; padding: 0; list-style: none;
    display: flex; gap: 1rem;
  }
  .card-wrap:nth-child(2) { translate: 0 .6rem; }
  .card {
    position: relative; display: grid; gap: .35rem; align-content: start;
    width: clamp(10rem, 15.5vw, 15rem); padding: .6rem .6rem 1rem;
    border-radius: 1.25rem; color: #fff; text-decoration: none;
    background: rgb(255 255 255 / .14);
    border: 1px solid rgb(255 255 255 / .22);
    -webkit-backdrop-filter: blur(16px) saturate(1.2);
    backdrop-filter: blur(16px) saturate(1.2);
    box-shadow: 0 20px 50px rgb(0 0 0 / .25);
  }
  .card__img { width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; border-radius: .9rem; background: rgb(255 255 255 / .1); }
  .card__title { margin-top: .4rem; padding: 0 .4rem; padding-right: 2.4rem; font: 300 1rem / 1.15 var(--serif); }
  .card__arrow {
    position: absolute; right: .75rem; bottom: .75rem; width: 1.9rem; height: 1.9rem;
    display: grid; place-items: center; border-radius: 50%; background: rgb(255 255 255 / .9);
  }
  .card__arrow svg { width: 55%; fill: none; stroke: #0a1020; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }

  /* ---------- Estado base = composição estática (sem JS / reduced-motion) ---------- */
  .title, .copy--2, .copy--3, .cards { display: none; }

  /* ---------- Estado inicial da versão animada ---------- */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hero .title { display: flex; }
    :global(.js) .hero .title__logo { opacity: 0; }
    :global(.js) .hero [data-reveal] { opacity: 0; }
    :global(.js) .hero .nav { visibility: hidden; }
    :global(.js) .hero .copy--1,
    :global(.js) .hero .copy--2,
    :global(.js) .hero .copy--3 { display: block; visibility: hidden; }
    :global(.js) .hero .cards { display: flex; visibility: hidden; }
    :global(.js) .hero .loader { display: flex; }
  }

  /* ---------- Desktop: stats empilhados à direita do bloco 1 ---------- */
  @media (min-width: 769px) {
    .copy--1 .stats { position: absolute; right: calc(-1 * min(26rem, 28vw)); bottom: .5rem; display: grid; gap: 1.4rem; }
  }

  /* ---------- Mobile ---------- */
  @media (max-width: 768px) {
    .nav__links { display: none; }
    .copy--1 { bottom: 1.5rem; }
    .stats { display: none; }
    .copy--2 { top: 14vh; }
    .copy--3 { right: 1.25rem; top: 11vh; }
    .cards { flex-direction: column; gap: .6rem; right: 1.25rem; }
    .card-wrap:nth-child(2) { translate: none; }
    .card { width: 100%; grid-template-columns: 4.5rem 1fr; column-gap: .8rem; padding: .5rem; align-items: center; }
    .card__img { grid-row: 1 / span 2; aspect-ratio: 1; }
    .card__title { margin: 0; padding: 0; padding-right: 2rem; font-size: .85rem; }
    .card__arrow { width: 1.6rem; height: 1.6rem; top: 50%; bottom: auto; translate: 0 -50%; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const root = document.querySelector<HTMLElement>('[data-hero]');

  if (root) {
    gsap.registerPlugin(ScrollTrigger);
    ScrollTrigger.config({ ignoreMobileResize: true });

    const $ = gsap.utils.selector(root);
    const logo = $('.title__logo') as HTMLElement[];

    const mm = gsap.matchMedia();

    mm.add(
      { motion: '(prefers-reduced-motion: no-preference)', mobile: '(max-width: 768px)' },
      (ctx) => {
        const { motion, mobile } = ctx.conditions as { motion: boolean; mobile: boolean };
        if (!motion) return;

        // ---- Entrada do logo (por tempo, independente do scroll) ----
        gsap.fromTo(
          logo,
          { opacity: 0, scale: 0.92, filter: 'blur(8px)' },
          {
            opacity: 1, scale: 1, filter: 'blur(0px)',
            duration: 1.5, ease: 'power3.out', delay: 0.3,
            clearProps: 'filter',
          }
        );

        // ---- Sequência de frames (canvas + loader) ----
        const canvas = $('[data-seq]')[0] as HTMLCanvasElement;
        const loader = $('[data-loader]')[0] as HTMLElement;
        const loaderCount = $('[data-loader-count]')[0] as HTMLElement;
        const loaderFill = $('[data-loader-fill]')[0] as HTMLElement;

        const dir = canvas.dataset.frameDir!;
        const count = Number(canvas.dataset.frameCount);

        const imgs: HTMLImageElement[] = [];
        const ready = new Array<boolean>(count).fill(false);
        let loaded = 0;
        let drawn = -1; // frame pintado
        let target = 0; // frame pedido pelo scroll

        const pad = (n: number) => String(n + 1).padStart(4, '0');

        const nearest = (from: number) => {
          if (ready[from]) return from;
          for (let d = 1; d < count; d++) {
            if (from - d >= 0 && ready[from - d]) return from - d;
            if (from + d < count && ready[from + d]) return from + d;
          }
          return -1;
        };

        const ctx2d = canvas.getContext('2d', { alpha: false });

        const paint = (i: number) => {
          const img = imgs[i];
          if (!ctx2d || !img || !img.naturalWidth) return;
          const w = canvas.width;
          const h = canvas.height;
          const s = Math.max(w / img.naturalWidth, h / img.naturalHeight);
          const dw = img.naturalWidth * s;
          const dh = img.naturalHeight * s;
          ctx2d.drawImage(img, (w - dw) / 2, (h - dh) / 2, dw, dh);
          drawn = i;
          canvas.classList.add('is-ready');
        };

        const show = (i: number) => {
          target = i;
          if (i === drawn) return;
          const idx = nearest(i);
          if (idx >= 0) paint(idx);
        };

        const resize = () => {
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          const rect = canvas.getBoundingClientRect();
          canvas.width = Math.max(1, Math.round(rect.width * dpr));
          canvas.height = Math.max(1, Math.round(rect.height * dpr));
          drawn = -1;
          const idx = nearest(target);
          if (idx >= 0) paint(idx);
        };

        resize();
        window.addEventListener('resize', resize);

        for (let i = 0; i < count; i++) {
          const img = new Image();
          img.decoding = 'async';
          img.onload = img.onerror = () => {
            ready[i] = img.naturalWidth > 0;
            loaded++;
            const pct = Math.round((loaded / count) * 100);
            loaderCount.textContent = `${pct}%`;
            loaderFill.style.transform = `scaleX(${loaded / count})`;
            if (drawn < 0) show(target);
            if (loaded === count) {
              gsap.to(loader, { autoAlpha: 0, duration: 0.5, delay: 0.15 });
              show(target);
            }
          };
          img.src = `${dir}/frame_${pad(i)}.jpg`;
          imgs[i] = img;
        }

        // ---- Timeline ligada ao scroll (unidades 0–100) ----
        const viewports = mobile ? 5 : 8;
        const proxy = { p: 0 };

        const tl = gsap.timeline({
          defaults: { ease: 'none' },
          scrollTrigger: {
            trigger: root,
            start: 'top top',
            end: () => `+=${window.innerHeight * viewports}`,
            pin: true,
            scrub: 0.7,
            anticipatePin: 1,
            invalidateOnRefresh: true,
          },
        });

        // Progresso → índice de frame (cover-fit no canvas)
        tl.to(proxy, { p: 1, duration: 100, onUpdate: () => show(Math.round(proxy.p * (count - 1))) }, 0);

        // 1) Logo: segura parado, depois escala até sair do quadro
        tl.to($('.title'), { scale: mobile ? 2.0 : 2.6, ease: 'power3.in', duration: 20 }, 6)
          .to($('.title'), { autoAlpha: 0, duration: 5 }, 24);

        // 2) Nav
        tl.fromTo('[data-nav]', { autoAlpha: 0, y: -14 }, { autoAlpha: 1, y: 0, duration: 4 }, 18);

        // 3) Bloco 1 — entra, segura, sai
        tl.set('[data-copy="1"]', { autoAlpha: 1 }, 26)
          .fromTo('[data-copy="1"] [data-reveal]', { opacity: 0, y: 32 }, { opacity: 1, y: 0, stagger: 1, duration: 4 }, 26)
          .to('[data-copy="1"]', { autoAlpha: 0, y: -48, duration: 6 }, 46);

        // Contadores do bloco 1 (reversíveis, ligados ao scroll)
        root.querySelectorAll<HTMLElement>('[data-count]').forEach((el, i) => {
          const targetValue = Number(el.dataset.count);
          const suffix = el.dataset.suffix ?? '';
          const state = { v: 0 };
          tl.fromTo(
            state,
            { v: 0 },
            { v: targetValue, duration: 12, onUpdate: () => { el.textContent = Math.round(state.v) + suffix; } },
            30 + i
          );
        });

        // 4) Bloco 2
        tl.set('[data-copy="2"]', { autoAlpha: 1 }, 54)
          .fromTo('[data-copy="2"] [data-reveal]', { opacity: 0, y: 32 }, { opacity: 1, y: 0, stagger: 1, duration: 4 }, 54)
          .to('[data-copy="2"]', { autoAlpha: 0, y: -48, duration: 6 }, 68);

        // 5) Bloco 3 + cards de vidro
        tl.set('[data-copy="3"]', { autoAlpha: 1 }, 76)
          .fromTo('[data-copy="3"] [data-reveal]', { opacity: 0, y: 24 }, { opacity: 1, y: 0, stagger: 1, duration: 4 }, 76)
          .set('[data-cards]', { autoAlpha: 1 }, 86)
          .fromTo('[data-cards] .card-wrap', { opacity: 0, y: 90 }, { opacity: 1, y: 0, stagger: 1.6, duration: 6 }, 86);

        return () => {
          window.removeEventListener('resize', resize);
        };
      }
    );
  }
</script>
