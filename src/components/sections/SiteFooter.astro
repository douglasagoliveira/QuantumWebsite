---
const services = [
  { label: 'Electrical services', href: 'https://quantumelectricalsolutions.com.au/electrical-instalations/' },
  { label: 'Maintenance', href: 'https://quantumelectricalsolutions.com.au/maintenance/' },
  { label: 'Sports Lighting', href: 'https://quantumelectricalsolutions.com.au/sports-lighting-quantum/' },
];
---

<footer class="foot" id="contacts" aria-label="Contact">
  <span class="energy" data-energy aria-hidden="true"></span>
  <div class="wrap">
    <div class="cta-row" data-reveal>
      <div>
        <h2 class="cta-title">Call us now for a free quote!</h2>
        <p class="cta-sub">Questions? Contact us.</p>
      </div>
      <a class="phone" href="tel:0406025213">0406 025 213</a>
    </div>

    <div class="grid" data-reveal-group>
      <div class="col">
        <h3 class="col__title">Contact</h3>
        <ul class="list">
          <li><a href="tel:0406025213">0406 025 213</a></li>
          <li><a href="mailto:info@quantumlec.net">info@quantumlec.net</a></li>
        </ul>
        <h3 class="col__title">Address</h3>
        <p class="addr">Sydney-Australia</p>
      </div>

      <div class="col">
        <h3 class="col__title">Services</h3>
        <ul class="list">
          {services.map((s) => (
            <li><a href={s.href}>{s.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="col">
        <h3 class="col__title">Follow Us</h3>
        <div class="social">
          <a href="https://www.instagram.com/quantum_elec/" aria-label="Instagram" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.2" cy="6.8" r="1" class="fill" /></svg>
          </a>
          <a href="https://www.linkedin.com/company/quantum-electrical-services-and-solutions/" aria-label="LinkedIn" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3" /><path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4" /></svg>
          </a>
        </div>
      </div>
    </div>

    <div class="legal" data-reveal>
      <p>Quantum Electrical &amp; Technological Services PTY LTD</p>
      <p>Electrical Contractor license no.: 478965C</p>
      <p>Master Security License: 000109137</p>
    </div>
  </div>
</footer>

<style>
  .foot {
    position: relative;
    padding: clamp(4rem, 11vh, 8rem) 0 3rem;
    background: var(--ink-2);
    overflow: hidden;
  }
  .energy {
    position: absolute; top: 0; left: 0; right: 0; height: 1px;
    background: linear-gradient(90deg, transparent, var(--volt) 30%, var(--electric) 60%, transparent);
    box-shadow: 0 0 24px 1px rgb(255 194 75 / .4);
    transform: scaleX(0);
  }
  .wrap { width: min(1200px, 92vw); margin: 0 auto; }

  .cta-row {
    display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1.5rem;
    padding-bottom: clamp(2rem, 5vh, 3.5rem);
    margin-bottom: clamp(2rem, 5vh, 3.5rem);
    border-bottom: 1px solid var(--line);
  }
  .cta-title { margin: 0; font: 300 clamp(1.9rem, 3.6vw, 3.2rem) / 1.05 var(--serif); }
  .cta-sub { margin: .6rem 0 0; font-size: .8rem; color: var(--muted); }
  .phone {
    font: 300 clamp(1.8rem, 3.2vw, 2.8rem) / 1 var(--serif);
    color: #fff; text-decoration: none;
    padding: .5rem 0;
    border-bottom: 1px solid rgb(255 194 75 / .5);
    text-shadow: 0 0 40px rgb(255 194 75 / .25);
    transition: color .3s, border-color .3s, text-shadow .3s;
  }
  .phone:hover { color: #ffe3a3; border-color: var(--volt); text-shadow: 0 0 40px rgb(255 194 75 / .6); }

  .grid { display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: 2rem; }
  .col__title { margin: 0 0 .9rem; font-size: .62rem; letter-spacing: .22em; text-transform: uppercase; color: rgb(233 238 251 / .55); }
  .col__title + .col__title, .list + .col__title, .addr { margin-top: 1.8rem; }
  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: .55rem; }
  .list a {
    color: rgb(233 238 251 / .85); text-decoration: none; font-size: .82rem;
    transition: color .25s, text-shadow .25s;
  }
  .list a:hover { color: #fff; text-shadow: 0 0 20px rgb(255 194 75 / .5); }
  .addr { margin: 0; font-size: .82rem; color: rgb(233 238 251 / .85); }

  .social { display: flex; gap: .7rem; }
  .social a {
    width: 2.4rem; height: 2.4rem;
    display: grid; place-items: center;
    border-radius: 50%;
    border: 1px solid var(--line);
    color: rgb(233 238 251 / .8);
    transition: color .3s, border-color .3s, box-shadow .35s, background .3s;
  }
  .social a:hover {
    color: #fff;
    border-color: rgb(255 194 75 / .55);
    background: rgb(255 194 75 / .08);
    box-shadow: 0 0 30px -8px rgb(255 194 75 / .85);
  }
  .social svg { width: 1.05rem; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .social svg .fill { fill: currentColor; stroke: none; }

  .legal {
    margin-top: clamp(2.5rem, 6vh, 4rem);
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
    display: grid; gap: .3rem;
  }
  .legal p { margin: 0; font-size: .68rem; color: rgb(233 238 251 / .5); }

  @media (max-width: 768px) {
    .grid { grid-template-columns: 1fr; gap: 2.2rem; }
  }
</style>
