---
const site = 'https://quantumelectricalsolutions.com.au';
const services = [
  {
    title: 'Design and Constructional',
    text: 'We operate across two strategic modalities: in Design, integrating all systems in partnership with electrical consultants, from inception; and in Constructional, auditing existing plans to implement engineering enhancements, optimizations, and seamless on-site integration without scope gaps.',
    href: `${site}/electrical-instalations/`,
  },
  {
    title: 'Smart Automation & Architectural Lighting',
    text: 'Luxury home automation ecosystems and invisible integration of designer luminaires. Precision DALI-2 flicker-free lighting control, human-centric circadian automation, and switch clutter elimination.',
    href: `${site}/maintenance/`,
  },
  {
    title: 'Electronic Security & Sports Lighting Infrastructure',
    text: 'Integrated perimeter security, keyless access control, and HD broadcast-ready sports lighting. Turnkey solutions for luxury estates, commercial developments, strata complexes, and local councils.',
    href: `${site}/sports-lighting-quantum/`,
  },
];
---

<section class="services" aria-label="Services">
  <div class="wrap">
    <div class="grid" data-reveal-group>
      {services.map((s) => (
        <article class="lamp" tabindex="0">
          <span class="lamp__bar" aria-hidden="true"></span>
          <span class="lamp__bulb" aria-hidden="true"></span>
          <h3 class="lamp__title">{s.title}</h3>
          <p class="lamp__text">{s.text}</p>
          <a class="lamp__cta" href={s.href}>
            More details
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" /></svg>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services {
    position: relative;
    padding: clamp(4.5rem, 12vh, 9rem) 0;
    background: var(--ink);
  }
  .wrap { width: min(1200px, 92vw); margin: 0 auto; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }

  /* ---------- Card=lâmpada ---------- */
  .lamp {
    position: relative;
    display: grid; gap: 1rem; align-content: start;
    padding: 2.2rem 1.6rem 1.7rem;
    border-radius: 1.25rem;
    background: linear-gradient(180deg, var(--ink-3), var(--ink-2));
    border: 1px solid var(--line);
    transition: transform .45s cubic-bezier(.2,.7,.2,1), border-color .35s, box-shadow .55s;
    will-change: transform;
    outline: none;
  }
  .lamp__bar {
    position: absolute; top: 0; left: 12%; right: 12%; height: 2px;
    border-radius: 0 0 2px 2px;
    background: linear-gradient(90deg, transparent, rgb(255 255 255 / .18), transparent);
    transition: background .35s, box-shadow .35s;
  }
  .lamp__bulb {
    width: .7rem; height: .7rem; border-radius: 50%;
    background: #16203a;
    box-shadow: inset 0 0 4px rgb(0 0 0 / .8);
    transition: background .2s, box-shadow .2s;
  }
  .lamp__title {
    margin: 0;
    font: 300 clamp(1.35rem, 1.7vw, 1.7rem) / 1.15 var(--serif);
    color: rgb(233 238 251 / .82);
    transition: color .35s, text-shadow .35s;
  }
  .lamp__text { margin: 0; font-size: .8rem; line-height: 1.65; color: var(--muted); transition: color .35s; }
  .lamp__cta {
    display: inline-flex; align-items: center; gap: .5rem;
    font-size: .62rem; letter-spacing: .18em; text-transform: uppercase;
    color: rgb(233 238 251 / .65); text-decoration: none;
    transition: color .3s;
  }
  .lamp__cta svg { width: .85rem; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; transition: transform .35s; }

  /* ---------- Estado LIGADO ---------- */
  .lamp:hover, .lamp:focus-visible {
    transform: translateY(-8px);
    border-color: rgb(255 194 75 / .45);
    box-shadow:
      0 0 0 1px rgb(255 194 75 / .12),
      0 32px 80px -34px rgb(255 194 75 / .5),
      0 0 100px -46px rgb(61 139 255 / .9);
  }
  .lamp:hover .lamp__bar, .lamp:focus-visible .lamp__bar {
    background: linear-gradient(90deg, transparent, var(--volt), transparent);
    box-shadow: 0 0 18px 2px rgb(255 194 75 / .45);
  }
  .lamp:hover .lamp__bulb, .lamp:focus-visible .lamp__bulb {
    background: radial-gradient(circle at 35% 30%, #fff, var(--volt) 62%, #c98a1d);
    box-shadow: 0 0 14px 3px rgb(255 194 75 / .85), 0 0 44px 12px rgb(255 194 75 / .35);
    animation: strike .45s ease-out;
  }
  .lamp:hover .lamp__title, .lamp:focus-visible .lamp__title {
    color: #fff;
    text-shadow: 0 0 30px rgb(255 194 75 / .35);
  }
  .lamp:hover .lamp__text, .lamp:focus-visible .lamp__text { color: rgb(233 238 251 / .88); }
  .lamp:hover .lamp__cta, .lamp:focus-visible .lamp__cta { color: #ffe3a3; }
  .lamp:hover .lamp__cta svg, .lamp:focus-visible .lamp__cta svg { transform: translate(2px, -2px); }

  @keyframes strike {
    0% { opacity: .15; }
    25% { opacity: 1; }
    40% { opacity: .25; }
    55% { opacity: 1; }
    70% { opacity: .55; }
    100% { opacity: 1; }
  }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .lamp { transition: none; }
    .lamp:hover .lamp__bulb { animation: none; }
  }
</style>
