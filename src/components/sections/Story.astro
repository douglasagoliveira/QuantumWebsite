---
const paragraphs = [
  'Partnering with Quantum from pre-construction is the smartest way to protect your margins, stay strictly on program, and deliver the exact vision your client demands.',
  'Mid-build variations and schedule delays are never accidental—they are the result of late electrical integration. Choosing Quantum means locking in your costs early, managing field execution in real time via SimPRO, and ensuring your client’s project is delivered on budget, on time, and on spec.',
  'Choosing Quantum isn’t just an electrical decision it’s smart project governance. By uniting power infrastructure, lighting design, and high-end automation under a single point of accountability, we eliminate mid-build variations, safeguard your schedule, and deliver the exact end-result your client envisioned, without budget blowouts.',
];
const includes = [
  'Fast, reliable installations to keep your project on schedule',
  'Scalable electrical systems designed for long-term performance',
  'Energy-efficient wiring and automation to reduce operational costs',
  'Seamless coordination with your construction team for hassle-free execution',
];
---

<section class="certainty" aria-label="Budget Certainty">
  <span class="energy" data-energy aria-hidden="true"></span>
  <div class="wrap">
    <h2 class="huge" data-light-words>Budget Certainty. Zero Timeline Surprises. High-End Operational Rigor.</h2>

    <div class="panels" data-reveal-group>
      {paragraphs.map((p, i) => (
        <p class:list={['panel', i === 2 && 'panel--wide']}>{p}</p>
      ))}
    </div>
  </div>
</section>

<section class="builders" aria-label="Reliable Electrical Solutions for Sydney’s Builders">
  <div class="wrap split">
    <div class="split__left">
      <h2 class="h2" data-reveal>Reliable Electrical Solutions for Sydney’s Builders</h2>
    </div>
    <div class="split__right">
      <p class="lead" data-reveal>
        At Quantum Electrical &amp; Technological Services, we partner with builders in Greater Sydney to
        deliver high-quality, compliant, and efficient electrical installations for residential and
        commercial projects. Our expertise ensures your developments meet strict safety standards, energy
        efficiency goals, and project timelines—without compromise.
      </p>
      <p class="lead" data-reveal>Our solutions include:</p>
      <ul class="checks" data-reveal-group>
        {includes.map((item) => (
          <li>
            <span class="checks__dot" aria-hidden="true"></span>
            {item}
          </li>
        ))}
      </ul>
      <p class="lead" data-reveal>
        With a focus on precision, compliance, and efficiency, we help you deliver top-tier projects—on time
        and within budget.
      </p>
    </div>
  </div>
</section>

<style>
  .certainty {
    position: relative;
    padding: clamp(5rem, 14vh, 10rem) 0 clamp(3rem, 8vh, 6rem);
    background: linear-gradient(180deg, var(--ink) 0%, var(--ink-2) 100%);
    overflow: hidden;
  }
  .energy {
    position: absolute; top: 0; left: 0; right: 0; height: 1px;
    background: linear-gradient(90deg, transparent, var(--electric) 30%, var(--volt) 55%, transparent);
    box-shadow: 0 0 24px 1px rgb(61 139 255 / .45);
    transform: scaleX(0);
  }
  .wrap { width: min(1200px, 92vw); margin: 0 auto; }

  .huge {
    margin: 0 0 clamp(2.5rem, 7vh, 5rem);
    font: 300 clamp(2.1rem, 5.2vw, 4.8rem) / 1.06 var(--serif);
    letter-spacing: -.01em;
    max-width: 18ch;
  }

  .panels { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .panel {
    margin: 0;
    padding: 1.6rem 1.4rem;
    border-radius: 1.1rem;
    background: rgb(255 255 255 / .045);
    border: 1px solid var(--line);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    font-size: .8rem; line-height: 1.7;
    color: var(--muted);
    box-shadow: 0 24px 60px -40px rgb(0 0 0 / .9);
    transition: border-color .4s, box-shadow .5s, background .4s;
  }
  .panel:hover {
    border-color: rgb(61 139 255 / .45);
    background: rgb(255 255 255 / .06);
    box-shadow: 0 0 0 1px rgb(61 139 255 / .15), 0 30px 70px -40px rgb(61 139 255 / .55);
  }
  .panel--wide { grid-column: 1 / -1; }

  /* ---------- Builders ---------- */
  .builders {
    padding: clamp(4rem, 11vh, 8rem) 0;
    background: var(--ink-2);
  }
  .split { display: grid; grid-template-columns: 1fr 1.15fr; gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .h2 {
    margin: 0;
    font: 300 clamp(1.9rem, 3.4vw, 3.2rem) / 1.1 var(--serif);
    position: sticky; top: 20vh;
  }
  .lead { margin: 0 0 1.2rem; font-size: .84rem; line-height: 1.75; color: var(--muted); }
  .lead:first-child { color: rgb(233 238 251 / .85); }

  .checks { list-style: none; margin: 0 0 1.6rem; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: .9rem 1.2rem; }
  .checks li {
    display: grid; grid-template-columns: auto 1fr; gap: .7rem; align-items: start;
    font-size: .78rem; line-height: 1.55; color: rgb(233 238 251 / .85);
    padding: .9rem 1rem;
    border-radius: .8rem;
    border: 1px solid var(--line);
    background: rgb(255 255 255 / .03);
    transition: border-color .35s, box-shadow .45s, background .35s;
  }
  .checks li:hover {
    border-color: rgb(255 194 75 / .4);
    background: rgb(255 255 255 / .05);
    box-shadow: 0 0 40px -18px rgb(255 194 75 / .8);
  }
  .checks__dot {
    width: .55rem; height: .55rem; margin-top: .35rem; border-radius: 50%;
    background: #16203a;
    box-shadow: inset 0 0 3px rgb(0 0 0 / .8);
    transition: background .2s, box-shadow .2s;
  }
  .checks li:hover .checks__dot {
    background: radial-gradient(circle at 35% 30%, #fff, var(--volt) 65%);
    box-shadow: 0 0 12px 3px rgb(255 194 75 / .75);
  }

  @media (max-width: 900px) {
    .panels { grid-template-columns: 1fr; }
    .split { grid-template-columns: 1fr; }
    .h2 { position: static; }
    .checks { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .energy { transform: none; }
  }
</style>
